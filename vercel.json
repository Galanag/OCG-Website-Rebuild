{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build:all",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "https://REPLACE_WITH_OCG_API_PROJECT.vercel.app/api/v1/$1" }
  ]
}
