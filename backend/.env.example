# Copy to backend/.env for local development. Never commit real credentials.

NODE_ENV=development
PORT=3100
PUBLIC_APP_URL=http://127.0.0.1:8000
API_PUBLIC_URL=http://127.0.0.1:3100/api/v1
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
COOKIE_SECURE=false
LOG_LEVEL=info

# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ocg_cms?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/ocg_cms?schema=public
DATABASE_CONNECTION_LIMIT=5

# Storage: local | supabase
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLIC_MEDIA_BUCKET=ocg-public-media
SUPABASE_PRIVATE_MEDIA_BUCKET=ocg-private-media
SUPABASE_SIGNED_URL_TTL_SECONDS=3600

# Initial admin bootstrap only. Use a strong password and remove/rotate after first login.
ADMIN_NAME=OCG Administrator
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OCG Website <no-reply@example.org>
EXPOSE_PASSWORD_RESET=false
SESSION_TTL_HOURS=8
PASSWORD_RESET_TTL_MINUTES=30
UPLOAD_MAX_BYTES=10485760
