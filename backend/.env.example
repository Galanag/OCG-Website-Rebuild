# Copy to backend/.env and replace every secret. Never commit the real .env.
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://127.0.0.1:8000
API_PUBLIC_URL=http://127.0.0.1:3000/api/v1
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
COOKIE_SECURE=false
LOG_LEVEL=info

# Prisma CLI uses DATABASE_URL. Runtime uses the discrete DATABASE_* values.
DATABASE_URL=mysql://ocg:replace-with-strong-password@127.0.0.1:3306/ocg_cms
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=ocg
DATABASE_PASSWORD=replace-with-strong-password
DATABASE_NAME=ocg_cms
DATABASE_CONNECTION_LIMIT=5

# First-administrator bootstrap. Run once with npm run bootstrap:admin.
ADMIN_NAME=OCG Administrator
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional SMTP. Without SMTP, password-reset tokens are written to the server log only in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OCG Website <no-reply@example.org>
EXPOSE_PASSWORD_RESET=false
SESSION_TTL_HOURS=8
PASSWORD_RESET_TTL_MINUTES=30
UPLOAD_MAX_BYTES=10485760